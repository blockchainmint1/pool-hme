# Copy to /etc/yiimp-api/env on the yiimp box, chmod 600.
YIIMP_API_PORT=8787
YIIMP_API_BIND=127.0.0.1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yiimpfrontend
MYSQL_USER=yiimp_ro
MYSQL_PASSWORD=REPLACE_ME

# Optional: enables /api/pool/stats to scrape stratum summary diag lines
STRATUM_LOG_DIR=/var/stratum

# Front-end origin(s), comma-separated. * = allow all (fine for public read-only).
CORS_ORIGIN=https://pool.honest.money,https://pool-hme.lovable.app

# --- DOGE payout registration (write path, v0.5.0) -------------------------
# Inert until this is 1. Flip only after MYSQL_REG_* is set and tested.
DOGE_REGISTER_ENABLED=0

# Separate MySQL user from the read-only one above. Grants:
#   GRANT SELECT, INSERT         ON yiimpfrontend.accounts           TO 'yiimp_reg'@'localhost';
#   GRANT SELECT, INSERT, UPDATE ON yiimpfrontend.doge_address_links TO 'yiimp_reg'@'localhost';
#   GRANT SELECT, INSERT         ON yiimpfrontend.doge_token_history TO 'yiimp_reg'@'localhost';
#   GRANT SELECT                 ON yiimpfrontend.coins              TO 'yiimp_reg'@'localhost';
MYSQL_REG_USER=yiimp_reg
MYSQL_REG_PASSWORD=REPLACE_ME

# Stable secret for the stateless captcha HMAC. Generate: openssl rand -hex 32
REGISTER_CAPTCHA_SECRET=REPLACE_ME

DOGE_ADDRESS_MODE=mainnet
DOGE_REGISTER_RATE_LIMIT_PER_HOUR=10

# validateaddress RPC. Left blank, the conf files below are parsed instead
# (the yiimp-api service user must be able to read them).
LTC_CONF=/home/ubuntu/.litecoin/litecoin.conf
DOGE_CONF=/home/ubuntu/.dogecoin/dogecoin.conf
# LTC_RPC_USER=
# LTC_RPC_PASSWORD=
# LTC_RPC_URL=http://127.0.0.1:9332/
# DOGE_RPC_USER=
# DOGE_RPC_PASSWORD=
# DOGE_RPC_URL=http://127.0.0.1:22555/
